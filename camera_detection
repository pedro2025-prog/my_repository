import cv2
from ultralytics import YOLO

# Path to the YOLO model weights
weights_path = "path_to_your_model/best.pt"  # Replace with the actual path
model = YOLO(weights_path)

def process_camera_feed():
    # Open the USB camera (index 0 for the default camera)
    cap = cv2.VideoCapture(0)  # Use 1, 2, etc., for additional cameras

    # Set the camera resolution to match YOLO's input size (e.g., 640x640)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 640)

    # Check if the camera is successfully opened
    if not cap.isOpened():
        print("Cannot open USB camera")
        return

    while True:
        # Capture a frame from the camera
        ret, frame = cap.read()
        if not ret:
            print("Failed to grab frame")
            break

        # Perform YOLO detection on the frame
        results = model.predict(source=frame, imgsz=640, conf=0.25, iou=0.3, max_det=2500)

        # Draw detection boxes on the frame
        if results and results[0].boxes is not None:
            for box in results[0].boxes:
                conf = box.conf[0].item()  # Confidence score
                if conf >= 0.25:
                    x1, y1, x2, y2 = map(int, box.xyxy[0])  # Bounding box coordinates
                    label = f"Capsule {conf:.2f}"  # Label with confidence
                    cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)  # Draw rectangle
                    cv2.putText(frame, label, (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)

        # Display the frame in a window
        cv2.imshow("YOLO Detection (USB Camera)", frame)

        # Exit the loop when 'q' is pressed
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    # Release the camera resources and close all OpenCV windows
    cap.release()
    cv2.destroyAllWindows()

# Run the function
process_camera_feed()
